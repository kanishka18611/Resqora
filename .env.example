# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Firebase
VITE_FIREBASE_API_KEY=your-firebase-key
FIREBASE_API_KEY=your-firebase-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_APP_ID=your-firebase-app-id
FIREBASE_VAPID_KEY=your-vapid-key
VITE_FIREBASE_STORAGE_BUCKET=your-storage-bucket
# JSON for the Firebase service account used by server-side push delivery.
FIREBASE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----","project_id":"your-project-id"}

# EmailJS
VITE_EMAILJS_SERVICE_ID=your-service-id
VITE_EMAILJS_PUBLIC_KEY=your-public-key
VITE_EMAILJS_TEMPLATE_ID=your-template-id

# Google Maps
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-key
GOOGLE_MAPS_API_KEY=your-google-maps-key

# SMS (optional; the UI falls back to manual channels when absent)
GATEWAYAPI_API_KEY=your-gatewayapi-key

# OpenRouter AI (server-only)
OPENROUTER_API_KEY=your-openrouter-key
# Optional override; the default is a free vision-capable model.
OPENROUTER_MODEL=google/gemma-3-27b-it:free
OPENROUTER_SITE_URL=http://localhost:8080

# Other APIs
# Add your other API keys here
